# ==============================
# MongoDB
# ==============================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aff

# ==============================
# JWT Auth
# ==============================
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# ==============================
# Auth security tuning
# ==============================
# bcrypt cost factor. Higher is slower and safer.
BCRYPT_ROUNDS=12
# Failed logins within LOGIN_WINDOW_SECONDS that trigger a lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
# How long an account stays locked, in minutes.
LOCKOUT_MINUTES=5

# ==============================
# Server
# ==============================
PORT=5000
NODE_ENV=development

# ==============================
# Stripe
# ==============================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ==============================
# Supabase Storage
# ==============================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ==============================
# Nodemailer
# ==============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-app-email@gmail.com
EMAIL_PASS=replace-with-app-password

# ==============================
# Frontend (if consumed via Vite/CRA)
# ==============================
CLIENT_URL=http://localhost:5173
