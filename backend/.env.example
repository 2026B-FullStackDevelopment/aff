# ==============================
# MongoDB
# ==============================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/aff

# ==============================
# JWT Auth
# ==============================
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h

# ==============================
# Server
# ==============================
PORT=5000
NODE_ENV=development

# ==============================
# Stripe
# ==============================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ==============================
# Supabase Storage
# ==============================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key

# ==============================
# Nodemailer
# ==============================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-app-email@gmail.com
EMAIL_PASS=replace-with-app-password

# ==============================
# Frontend (if consumed via Vite/CRA)
# ==============================
CLIENT_URL=http://localhost:5173
