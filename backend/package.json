{
  "name": "aff-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js/Express backend for AFF.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "send-test-email": "node ../node_modules/tsx/dist/cli.mjs src/scripts/send-test-email.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.3",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
