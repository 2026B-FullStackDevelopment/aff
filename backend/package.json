{
  "name": "aff-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js/Express backend for AFF.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node ../node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ../node_modules/typescript/bin/tsc",
    "start": "node dist/server.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "mongoose": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
