# Keep generated dependencies and build output out of Git.
node_modules/
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# Environment files (never commit real secrets; .env.example stays tracked).
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage output
coverage/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Agent Plans
docs/superpowers/*

# Claude Code agent workspace (includes nested worktrees)
.claude/

# Parallel development worktrees (created outside the repo; this is a safety net)
.worktrees/
