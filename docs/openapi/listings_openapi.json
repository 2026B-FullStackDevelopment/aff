{
  "openapi": "3.0.0",
  "info": {
    "title": "AFF Listings Browse API",
    "version": "0.1.0",
    "description": "The public, unauthenticated Recipient browse endpoint (Epic D — D1 base pagination, D6 search/filter/sort). Reflects backend/src/modules/listings/listing.controller.ts::listAvailableListings as implemented. Listing detail (GET /listings/{id}) and every Donor-owned listings-management endpoint are documented in donor_openai.json, not here, to avoid documenting the same path in two files."
  },
  "servers": [
    { "url": "http://localhost:5000/api", "description": "Local development" }
  ],
  "tags": [
    { "name": "Listings Browse", "description": "Search, filter, sort, and paginate publicly-active listings" }
  ],
  "paths": {
    "/listings": {
      "get": {
        "tags": ["Listings Browse"],
        "operationId": "listAvailableListings",
        "summary": "Browse active listings",
        "description": "Public endpoint — no authentication required. Always scoped to status=ACTIVE; status is not an accepted query parameter and PAUSED/CANCELLED/SOLD_OUT listings never appear. search is a case-insensitive partial match on name. city is an exact match (Listing.city is copied from the Donor's fixed-dropdown profile city at creation time, not free text). priceMin/priceMax filter on price (VND). sort=price with order controls result ordering; with no sort, results are always createdAt desc regardless of any supplied order — order only takes effect when sort=price is also present. All filters compose together in a single request.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive partial match on listing name",
            "schema": { "type": "string" }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Exact match against the Donor's municipality",
            "schema": { "type": "string" },
            "example": "Thành phố Hà Nội"
          },
          {
            "name": "category",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/FoodCategory" }
          },
          {
            "name": "priceMin",
            "in": "query",
            "description": "Inclusive lower bound on price (VND)",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "priceMax",
            "in": "query",
            "description": "Inclusive upper bound on price (VND)",
            "schema": { "type": "number", "minimum": 0 }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Only price sort is supported. With no sort, results are createdAt desc.",
            "schema": {
              "type": "string",
              "enum": ["price"]
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Only takes effect when sort=price is also supplied; ignored otherwise",
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "desc"
            }
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "A page of active listings matching the supplied filters",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AvailableListingsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": { "type": "string" }
        }
      },
      "MeasurementUnit": {
        "type": "string",
        "enum": ["KILOGRAM", "GRAM", "LITER", "MILLILITER", "UNIT", "PER_REQUEST"]
      },
      "FoodCategory": {
        "type": "string",
        "enum": ["FRUIT", "VEGETABLE", "MEAT", "COOKED_DISH", "BAKED_GOODS", "DRINK"]
      },
      "ListingStatus": {
        "type": "string",
        "enum": ["ACTIVE", "PAUSED", "CANCELLED", "SOLD_OUT"],
        "description": "GET /listings only ever returns ACTIVE"
      },
      "GeoLocation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latitude", "longitude", "updatedAt"],
        "properties": {
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "ListingDonorSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "companyName", "city", "location"],
        "properties": {
          "id": { "type": "string" },
          "companyName": { "type": "string" },
          "city": { "type": "string" },
          "location": { "$ref": "#/components/schemas/GeoLocation" }
        }
      },
      "Listing": {
        "type": "object",
        "required": ["id", "donor", "name", "description", "imageUrl", "unit", "category", "isVegetarian", "price", "city", "status", "donationLimit", "rationLimitPerPerson", "quantityRemaining", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "donor": { "$ref": "#/components/schemas/ListingDonorSummary" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "imageUrl": { "type": "string", "format": "uri", "nullable": true },
          "unit": { "$ref": "#/components/schemas/MeasurementUnit" },
          "category": { "$ref": "#/components/schemas/FoodCategory" },
          "isVegetarian": { "type": "boolean" },
          "price": { "type": "number" },
          "city": { "type": "string" },
          "status": { "$ref": "#/components/schemas/ListingStatus" },
          "donationLimit": { "type": "number" },
          "rationLimitPerPerson": { "type": "number", "nullable": true },
          "quantityRemaining": { "type": "number" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AvailableListingsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data"],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items", "page", "limit", "total"],
            "properties": {
              "items": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Listing" }
              },
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total": { "type": "integer" }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Query validation failed. .strict() also rejects unknown parameters, including a client-supplied status and Epic F fields (rank/lat/lng).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "examples": {
              "unknownField": { "value": { "message": "Unrecognized key: status" } },
              "priceRange": { "value": { "message": "Minimum price cannot be greater than maximum price." } }
            }
          }
        }
      }
    }
  }
}
