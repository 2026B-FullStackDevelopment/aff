{
  "name": "aff-team1",
  "version": "0.1.0",
  "private": true,
  "description": "AFF full-stack group project monorepo.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "start:backend": "npm --workspace backend start",
    "build:backend": "npm --workspace backend run build",
    "build:frontend": "npm --workspace frontend run build",
    "typecheck": "npm --workspace backend run typecheck && npm --workspace frontend run typecheck"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "country-state-city": "^3.2.1",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0",
    "socket": "^1.1.158"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22"
  }
}
